<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#063A18">

    <!-- TOP HEADER -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:clickable="true"
            android:contentDescription="Back"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Manage Availability"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- MAIN ROUNDED CONTENT SHEET -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerContainer"
        app:cardBackgroundColor="#F4F6F4"
        app:cardCornerRadius="28dp"
        app:cardElevation="6dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- SCROLLABLE BODY -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_above="@id/bottomActionContainer"
                android:clipToPadding="false"
                android:paddingBottom="20dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- 1. SET YOUR AVAILABILITY SWITCH CARD -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="20dp"
                            android:paddingVertical="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:text="Set Your Availability"
                                android:textColor="#212121"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switchAvailability"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:checked="true"
                                app:thumbTint="#FFFFFF"
                                app:trackTint="#063A18" />
                        </RelativeLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- 2. AVAILABLE DAYS SECTION -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Available Days"
                        android:textColor="#212121"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="24dp">

                        <CheckBox
                            android:id="@+id/chkMonday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="Monday"
                            android:textColor="#212121"
                            android:textSize="14sp"
                            android:buttonTint="#063A18"
                            android:paddingStart="8dp" />

                        <CheckBox
                            android:id="@+id/chkTuesday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="Tuesday"
                            android:textColor="#212121"
                            android:textSize="14sp"
                            android:buttonTint="#063A18"
                            android:paddingStart="8dp" />

                        <CheckBox
                            android:id="@+id/chkWednesday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="Wednesday"
                            android:textColor="#212121"
                            android:textSize="14sp"
                            android:buttonTint="#063A18"
                            android:paddingStart="8dp" />

                        <CheckBox
                            android:id="@+id/chkThursday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="Thursday"
                            android:textColor="#212121"
                            android:textSize="14sp"
                            android:buttonTint="#063A18"
                            android:paddingStart="8dp" />

                        <CheckBox
                            android:id="@+id/chkFriday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="Friday"
                            android:textColor="#212121"
                            android:textSize="14sp"
                            android:buttonTint="#063A18"
                            android:paddingStart="8dp" />

                        <CheckBox
                            android:id="@+id/chkSaturday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false"
                            android:text="Saturday"
                            android:textColor="#212121"
                            android:textSize="14sp"
                            android:buttonTint="#063A18"
                            android:paddingStart="8dp" />

                        <CheckBox
                            android:id="@+id/chkSunday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false"
                            android:text="Sunday"
                            android:textColor="#212121"
                            android:textSize="14sp"
                            android:buttonTint="#063A18"
                            android:paddingStart="8dp" />
                    </LinearLayout>

                    <!-- 3. TIME SLOTS SECTION -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Time Slots"
                        android:textColor="#212121"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <!-- Row 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_card_selected"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="8:00 AM – 10:00 AM"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_card_selected"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="1:00 PM – 3:00 PM"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Row 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="20dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_card_unselected"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="10:00 AM – 12:00 PM"
                            android:textColor="#333333"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_card_unselected"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="3:00 PM – 5:00 PM"
                            android:textColor="#333333"
                            android:textSize="12sp" />
                    </LinearLayout>

                </LinearLayout>
            </ScrollView>

            <!-- FLOATING SAVE CHANGES BUTTON CONTAINER -->
            <LinearLayout
                android:id="@+id/bottomActionContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:background="#F4F6F4"
                android:padding="16dp">

                <Button
                    android:id="@+id/btnSaveChanges"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:backgroundTint="#063A18"
                    android:text="Save Changes"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="25dp" />
            </LinearLayout>

        </RelativeLayout>
    </androidx.cardview.widget.CardView>

</RelativeLayout>